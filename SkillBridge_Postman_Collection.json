            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skillName\": \"Kubernetes & Container Orchestration\",\n  \"category\": \"DevOps & Cloud\",\n  \"description\": \"Pods, deployments, services and helm charts\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/skills", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "skills"] }
          }
        },
        {
          "name": "3. Search Mentors",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/api/skills/mentors?query=Java&category=Software Engineering&proficiency=ADVANCED", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "skills", "mentors"], "query": [{ "key": "query", "value": "Java" }, { "key": "category", "value": "Software Engineering" }, { "key": "proficiency", "value": "ADVANCED" }] }
          }
