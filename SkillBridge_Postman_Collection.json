    {
      "name": "Mentoring Requests",
      "item": [
        {
          "name": "1. Send Mentoring Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mentorId\": 2,\n  \"skillId\": 4,\n  \"preferredDateTime\": \"Thursday 4:00 PM\",\n  \"message\": \"Hi Priya, looking to learn Figma auto-layout and components!\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/requests", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "requests"] }
          }
        },
        {
          "name": "2. Get My Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "http://localhost:8080/api/requests/my", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "requests", "my"] }
          }
        },
        {
          "name": "3. Accept Request",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "http://localhost:8080/api/requests/1/accept", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "requests", "1", "accept"] }
          }
        },
        {
          "name": "4. Reject Request",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "http://localhost:8080/api/requests/1/reject", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "requests", "1", "reject"] }
          }
        }
      ]
